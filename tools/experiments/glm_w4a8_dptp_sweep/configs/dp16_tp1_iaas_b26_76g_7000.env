# DP16/TP1 IaaS continuation after the historical B16/B256 result.
# B26 at 32K needs 6708 blocks and 71.84 GiB MLA KV per DP.
# Allow for per-layer host-pool alignment overhead beyond raw MLA KV.
export GLM_DP_SIZE=16
export GLM_TP_SIZE=1
export GLM_MAX_LOCAL_BATCH=26
export GLM_BUCKETS=
export GLM_DRAM_GIB_PER_DP=76
export GLM_IAAS_BLOCKS=7000
export GLM_HBM_UTIL=0.92
export GLM_REMOTE_HOST=7.150.13.62
export GLM_REMOTE_STORE_PORT=29740
export GLM_REMOTE_PROFILE_DEVICE=0
export GLM_PROFILE_DEVICE_BREAKDOWN=0
export GLM_PROFILER_DIR=
