# Extension beyond the B32 graph/100 GiB host KV pool.
# 32K/B576, 64K/B288, 128K/B144 each need roughly 9.2k index blocks
# and 99.5 GiB MLA KV per DP; 108 GiB leaves alignment headroom.
export GLM_DP_SIZE=16
export GLM_TP_SIZE=1
export GLM_MAX_LOCAL_BATCH=36
export GLM_BUCKETS=
export GLM_DRAM_GIB_PER_DP=108
export GLM_IAAS_BLOCKS=10000
export GLM_HBM_UTIL=0.92
export GLM_REMOTE_HOST=7.150.13.62
export GLM_REMOTE_STORE_PORT=29740
export GLM_REMOTE_PROFILE_DEVICE=0
export GLM_PROFILE_DEVICE_BREAKDOWN=0
export GLM_PROFILER_DIR=
export GLM_DECODER_CONTAINER=glm5_iaas_decoder
