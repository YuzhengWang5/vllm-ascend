# First extension beyond the DP16/TP1 B26 graph and 76 GiB host pool.
# 32K/B512, 64K/B256, and 128K/B128 each need about 8,200 index blocks
# and about 88 GiB of MLA KV per DP; leave alignment and scheduler headroom.
export GLM_DP_SIZE=16
export GLM_TP_SIZE=1
export GLM_MAX_LOCAL_BATCH=32
export GLM_BUCKETS=
export GLM_DRAM_GIB_PER_DP=100
export GLM_IAAS_BLOCKS=9000
export GLM_HBM_UTIL=0.92
export GLM_REMOTE_HOST=7.150.13.62
export GLM_REMOTE_STORE_PORT=29740
export GLM_REMOTE_PROFILE_DEVICE=0
export GLM_PROFILE_DEVICE_BREAKDOWN=0
export GLM_PROFILER_DIR=
export GLM_DECODER_CONTAINER=glm5_iaas_decoder
