# DP8/TP2 matched colocated/IaaS graph setup. TP pairs are SIO neighbors.
# 32K/B320 needs 10320 blocks and 110.5 GiB MLA KV per DP.
export GLM_DP_SIZE=8
export GLM_TP_SIZE=2
export GLM_MAX_LOCAL_BATCH=40
export GLM_BUCKETS=1,2,4,8,12,16,20,24,28,32,36,40
export GLM_DRAM_GIB_PER_DP=120
export GLM_IAAS_BLOCKS=12000
export GLM_HBM_UTIL=0.92
export GLM_REMOTE_HOST=7.150.13.62
export GLM_REMOTE_STORE_PORT=29740
export GLM_REMOTE_PROFILE_DEVICE=0
export GLM_PROFILE_DEVICE_BREAKDOWN=0
export GLM_PROFILER_DIR=
export GLM_DECODER_CONTAINER=glm5_iaas_decoder
